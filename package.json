{
  "name": "dsh-web-discovery",
  "version": "1.0.0",
  "description": "Discovery companion for dsh-web-missions: local search engines (SearXNG HTTP JSON + browser39 search CLI) behind a DiscoveryPort — the mission core only sees URLs in / URLs out.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-web-discovery.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-web-discovery#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-web-discovery/issues"
  },
  "scripts": {
    "build": "node build.mjs && tsc --noEmit",
    "smoke": "node build.mjs && node scripts/smoke-m7.mjs",
    "test": "node scripts/smoke-m7.mjs",
    "prepare": "node build.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "web-missions",
    "discovery",
    "searxng",
    "browser39",
    "agent-tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dsh-build-tools": "^0.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "janpauldahlke@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
